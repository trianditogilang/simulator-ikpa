{
  "name": "simpatik-v0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/web",
    "generate-routes": "npm run generate-routes --workspace apps/web",
    "build": "npm run build --workspace apps/web",
    "preview": "npm run preview --workspace apps/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "biome format .",
    "lint": "biome lint .",
    "check": "npm run typecheck && npm run test && npm run lint"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@types/node": "^22.10.2",
    "marked": "^18.0.11",
    "pdfkit": "^0.20.2",
    "typescript": "^6.0.2"
  }
}
