# ==============================================================================
# Simulator Penilaian IKPA — Environment Variables Template
# Copy this file to `.env` and fill in the required values.
# NEVER commit the actual `.env` file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database (PostgreSQL, encoding UTF8) — SERVER ONLY
# ------------------------------------------------------------------------------
# Untuk `npm run dev` di host. Dengan `docker compose up`, database lokal
# tersedia di 127.0.0.1:5432 (lihat bagian 7). Di dalam container, compose
# merakit DATABASE_URL sendiri dan mengabaikan nilai ini.
DATABASE_URL=postgresql://ikpa:password@127.0.0.1:5432/simulator_ikpa

# Dipakai drizzle-kit (migrate); bila kosong memakai DATABASE_URL.
# DIRECT_URL=postgresql://ikpa:password@127.0.0.1:5432/simulator_ikpa

# ------------------------------------------------------------------------------
# 2. Authentication (Better Auth, self-hosted) — SERVER ONLY
# ------------------------------------------------------------------------------
# Kunci penanda tangan sesi dan cookie, minimal 32 karakter acak.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=ganti_dengan_minimal_32_karakter_acak

# ------------------------------------------------------------------------------
# 3. Email (SMTP) — SERVER ONLY
# ------------------------------------------------------------------------------
# Dipakai untuk kode OTP, undangan, dan reminder. Lokal: penangkap email Mailpit
# (`docker compose --profile dev up -d mailpit`, kotak masuk di http://127.0.0.1:8025).
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASSWORD=
NOTIFICATION_SENDER_EMAIL=notifikasi-ikpa@kemenkeu.go.id

# ------------------------------------------------------------------------------
# 4. Job Scheduler (cron service `scheduler` di docker-compose) — SERVER ONLY
# ------------------------------------------------------------------------------
# Dikirim sebagai `Authorization: Bearer ...` ke /api/jobs/*; minimal 32 karakter acak.
JOB_SECRET=job_secret_sample_placeholder_min_32_chars

# ------------------------------------------------------------------------------
# 5. File Import CSV/XLSX — tidak butuh variabel
# ------------------------------------------------------------------------------
# Berkas di-parse di memori dan tidak pernah disimpan (ADR-008, MIG-06).

# ------------------------------------------------------------------------------
# 6. Application Environment
# ------------------------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 7. Docker Compose (ADR-008) — dibaca `docker compose`, bukan aplikasi
# ------------------------------------------------------------------------------
# Wajib. Hindari karakter @ : / ? # karena nilai ini masuk ke connection string.
POSTGRES_PASSWORD=ganti_dengan_sandi_acak
# POSTGRES_PORT=5432
# MAILPIT_SMTP_PORT=1025
# MAILPIT_UI_PORT=8025
# ":80" = HTTP lokal. Di VPS isi nama domain agar Caddy mengurus TLS otomatis.
# SITE_ADDRESS=:80
# HTTP_PORT=80
# HTTPS_PORT=443
