# ==============================================================================
# Simulator Penilaian IKPA — Environment Variables Template
# Copy this file to `.env` and fill in the required values.
# NEVER commit the actual `.env` file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database (Neon PostgreSQL) — SERVER ONLY
# ------------------------------------------------------------------------------
# Connection string with pooled connection (for serverless queries)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.ap-southeast-1.aws.neon.tech/simulator_ikpa?sslmode=require

# Direct connection string (for migrations / schema push)
# DIRECT_URL=postgresql://user:password@ep-sample.ap-southeast-1.aws.neon.tech/simulator_ikpa?sslmode=require

# ------------------------------------------------------------------------------
# 2. Authentication (Clerk)
# ------------------------------------------------------------------------------
# Public key for browser UI (VITE_ prefix makes it accessible in client bundle)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_sample_clerk_key_placeholder

# Secret key for server-side auth verification (SERVER ONLY)
CLERK_SECRET_KEY=sk_test_sample_clerk_secret_placeholder

# ------------------------------------------------------------------------------
# 3. Notification & Email Delivery (Resend) — SERVER ONLY
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_sample_resend_key_placeholder
NOTIFICATION_SENDER_EMAIL=notifikasi-ikpa@kemenkeu.go.id

# ------------------------------------------------------------------------------
# 4. Job Scheduler & Cron (Upstash QStash) — SERVER ONLY
# ------------------------------------------------------------------------------
QSTASH_TOKEN=qstash_token_sample_placeholder
QSTASH_CURRENT_SIGNING_KEY=sig_current_sample_placeholder
QSTASH_NEXT_SIGNING_KEY=sig_next_sample_placeholder

# ------------------------------------------------------------------------------
# 5. File Storage for CSV/XLSX Import (Cloudflare R2) — SERVER ONLY
# ------------------------------------------------------------------------------
R2_ACCOUNT_ID=sample_r2_account_id
R2_ACCESS_KEY_ID=sample_r2_access_key
R2_SECRET_ACCESS_KEY=sample_r2_secret_key
R2_BUCKET_NAME=simulator-ikpa-imports

# ------------------------------------------------------------------------------
# 6. Application Environment
# ------------------------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
